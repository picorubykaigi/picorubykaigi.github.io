<%-
by_name = ->(session) { [session[:speaker_label].ascii_only? ? 0 : 1, session[:speaker_label].downcase] }
sections = [
  ['Keynote', 'keynote', %w[hasumikin matz].map { |handle| sessions.fetch(handle) }],
  ['Talk', 'talk', sessions.values.select { |session| session[:kind] == :talk }.sort_by(&by_name)],
  ['Showcase', 'showcase', sessions.values.select { |session| session[:kind] == :showcase }.sort_by(&by_name)]
]
-%>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <symbol id="icon-x" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </symbol>
    <symbol id="icon-github" viewBox="0 0 16 16">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
    </symbol>
  </svg>

  <main class="container container-wide">
    <div class="panel">
      <div class="team-header speakers-header">
        <h1 class="team-title">Speakers</h1>
        <div class="blog-dancers team-dancers" aria-hidden="true">
          <div class="blog-dancer"><span class="blog-dancer-led"></span></div>
          <div class="blog-dancer"><span class="blog-dancer-led"></span></div>
          <div class="blog-dancer"><span class="blog-dancer-led"></span></div>
          <div class="blog-dancer"><span class="blog-dancer-led"></span></div>
        </div>
      </div>

<%- sections.each do |heading, kind, speakers| -%>
      <section class="team-section">
        <h2><%= heading %></h2>
        <ul class="speaker-list speaker-list-<%= kind %>">
  <%- speakers.each do |speaker| -%>
          <li class="speaker-card speaker-card-<%= kind %>">
            <div class="speaker-body">
              <img class="speaker-photo" src="/<%= Dir.glob("images/speakers/#{speaker[:handle]}.*").first %>" alt="" loading="lazy">
              <div class="speaker-meta">
                <p class="speaker-name<%= speaker[:speaker_label].ascii_only? ? '' : ' speaker-name-ja' %>"><%= speaker[:speaker] %></p>
                <p class="team-id">@<%= speaker[:github] || speaker[:x] %></p>
                <p class="team-links speaker-links">
    <%- if speaker[:github] -%>
                  <a href="https://github.com/<%= speaker[:github] %>" target="_blank" rel="noopener" aria-label="GitHub"><svg><use href="#icon-github"/></svg></a>
    <%- end -%>
    <%- if speaker[:x] -%>
                  <a href="https://x.com/<%= speaker[:x] %>" target="_blank" rel="noopener" aria-label="X"><svg><use href="#icon-x"/></svg></a>
    <%- end -%>
                </p>
              </div>
    <%- if speaker[:bio] -%>
              <p class="speaker-bio"><%= escape(speaker[:bio]).gsub("\n", '<br>') %></p>
    <%- end -%>
            </div>
          </li>
  <%- end -%>
        </ul>
      </section>
<%- end -%>
    </div>
  </main>
